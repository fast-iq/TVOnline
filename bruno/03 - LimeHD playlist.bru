meta {
  name: LimeHD playlist
  type: http
  seq: 3
}

post {
  url: {{base}}/api/v4/playlist
  body: form-urlencoded
  auth: none
}

params:query {
  tz: {{tz}}
  region: {{region}}
  limit: 0
  epg: 1
  epgcnt: 4
  epg_limit: 4
  installts: 1700000000
  needCategories: 0
  drm: 0
}

headers {
  User-Agent: {"platform":"android.tv","app":"limehd.ru.lite","version_name":"4.1.2","version_code":"514","sdk":"36","name":"Android TV","device_id":"7f3c8f0b1b2e4f5a","is_huawei":"0"}
  X-LHD-Agent: {"platform":"android.tv","app":"limehd.ru.lite","version_name":"4.1.2","version_code":"514","sdk":"36","name":"Android TV","device_id":"7f3c8f0b1b2e4f5a","is_huawei":"0"}
  Accept: application/json
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  payload: {{payload}}
}
