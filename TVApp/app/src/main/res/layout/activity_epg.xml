<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/epg"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_margin="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/currentTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_placeholder"
        android:textSize="18sp"
        android:textColor="@color/accent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Общая временная шкала -->
    <HorizontalScrollView
        android:id="@+id/timeScaleScroll"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        android:background="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/currentTimeText"
        app:layout_constraintStart_toEndOf="@id/channelLabelsArea"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/timeScaleContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <!-- Временные метки будут добавлены программно -->
        </FrameLayout>
    </HorizontalScrollView>

    <!-- Вертикальная прокрутка каналов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/epgLabelsList"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/timeScaleScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Область для названий каналов над лентой -->
    <FrameLayout
        android:id="@+id/channelLabelsArea"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/currentTimeText"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/channels"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Основная область с программой передач -->
    <HorizontalScrollView
        android:id="@+id/epgHorizontalScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        app:layout_constraintTop_toBottomOf="@id/timeScaleScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/epgLabelsList"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgRowsList"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
