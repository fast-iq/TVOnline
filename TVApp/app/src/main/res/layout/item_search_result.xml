<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_pill"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/searchItemLogo"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/channel_logo_desc" />

    <TextView
        android:id="@+id/searchItemNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?attr/tvAccentSecondary"
        android:layout_marginStart="12dp" />

    <TextView
        android:id="@+id/searchItemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="?attr/tvTextPrimary"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
