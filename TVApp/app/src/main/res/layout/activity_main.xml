<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="0.04"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/titleAccentBar"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_accent_bar"
        android:layout_marginStart="32dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/epgButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_epg"
        android:contentDescription="@string/epg"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_icon_button"
        android:padding="10dp"
        android:elevation="4dp"
        android:layout_marginEnd="12dp"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleAccentBar"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_icon_button"
        android:padding="10dp"
        android:elevation="4dp"
        android:layout_marginEnd="32dp"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleAccentBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/currentProgramText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/select_channel"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="32dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/titleAccentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/regionText" />

    <TextView
        android:id="@+id/regionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/accent_secondary"
        android:background="@drawable/bg_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="@id/currentProgramText"
        app:layout_constraintBottom_toBottomOf="@id/currentProgramText"
        app:layout_constraintStart_toEndOf="@id/currentProgramText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/currentProgramText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/numberOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/number_overlay_bg"
        android:padding="14dp"
        android:minWidth="200dp"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
