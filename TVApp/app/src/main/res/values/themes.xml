<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Сменные темы оформления. Общее — в Base; каждая тема задаёт палитру через
      семантические tv*-атрибуты (см. attrs.xml) и шрифт. Игровая сцена
      (плеер) всегда на чёрном фоне — для неё .Black-вариант каждой темы.
      Выбор темы хранится в AppPreferences.uiTheme и применяется в BaseActivity.
    -->
    <style name="Theme.TVApp.Base" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorPrimary">?attr/tvAccent</item>
        <item name="android:colorPrimaryDark">?attr/tvBackground</item>
        <item name="android:colorAccent">?attr/tvAccent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:textColorPrimary">?attr/tvTextPrimary</item>
        <item name="android:textColorSecondary">?attr/tvTextSecondary</item>
        <item name="tvOptionText">@color/option_button_text</item>

        <!-- TV оптимизации -->
        <item name="android:defaultFocusHighlightEnabled">true</item>
    </style>

    <!-- Полночь: привычная тёмно-сине-фиолетовая (тема по умолчанию) -->
    <style name="Theme.TVApp" parent="Theme.TVApp.Base">
        <item name="tvBackground">@color/midnight_bg</item>
        <item name="tvBgTop">@color/midnight_top</item>
        <item name="tvBgBottom">@color/midnight_bottom</item>
        <item name="tvSurface">@color/midnight_surface</item>
        <item name="tvSurfaceHigh">@color/midnight_surface_high</item>
        <item name="tvSurfaceStroke">@color/midnight_stroke</item>
        <item name="tvAccent">@color/midnight_accent</item>
        <item name="tvAccentSecondary">@color/midnight_accent2</item>
        <item name="tvTextPrimary">@color/midnight_text_primary</item>
        <item name="tvTextSecondary">@color/midnight_text_secondary</item>
        <item name="tvTextHint">@color/midnight_text_hint</item>
        <item name="tvLive">@color/midnight_live</item>
        <item name="tvLiveBg">@color/midnight_live_bg</item>
        <item name="tvSelected">@color/midnight_selected</item>
        <item name="tvSelectedBg">@color/midnight_selected_bg</item>
        <item name="tvWarning">@color/midnight_warning</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.TVApp.Black" parent="Theme.TVApp">
        <item name="android:windowBackground">@color/black</item>
        <!-- Чёрная сцена плеера: текст остаётся светлым даже в светлой палитре -->
        <item name="tvTextPrimary">@color/midnight_text_primary</item>
        <item name="tvTextSecondary">@color/midnight_text_secondary</item>
    </style>

    <!-- Изумруд: тёмно-зелёная «терминальная», моноширинный шрифт -->
    <style name="Theme.TVApp.Emerald" parent="Theme.TVApp.Base">
        <item name="tvBackground">@color/emerald_bg</item>
        <item name="tvBgTop">@color/emerald_top</item>
        <item name="tvBgBottom">@color/emerald_bottom</item>
        <item name="tvSurface">@color/emerald_surface</item>
        <item name="tvSurfaceHigh">@color/emerald_surface_high</item>
        <item name="tvSurfaceStroke">@color/emerald_stroke</item>
        <item name="tvAccent">@color/emerald_accent</item>
        <item name="tvAccentSecondary">@color/emerald_accent2</item>
        <item name="tvTextPrimary">@color/emerald_text_primary</item>
        <item name="tvTextSecondary">@color/emerald_text_secondary</item>
        <item name="tvTextHint">@color/emerald_text_hint</item>
        <item name="tvLive">@color/emerald_live</item>
        <item name="tvLiveBg">@color/emerald_live_bg</item>
        <item name="tvSelected">@color/emerald_selected</item>
        <item name="tvSelectedBg">@color/emerald_selected_bg</item>
        <item name="tvWarning">@color/emerald_warning</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Theme.TVApp.Emerald.Black" parent="Theme.TVApp.Emerald">
        <item name="android:windowBackground">@color/black</item>
        <item name="tvTextPrimary">@color/midnight_text_primary</item>
        <item name="tvTextSecondary">@color/midnight_text_secondary</item>
    </style>

    <!-- Закат: тёплая янтарно-оранжевая, шрифт с засечками -->
    <style name="Theme.TVApp.Sunset" parent="Theme.TVApp.Base">
        <item name="tvBackground">@color/sunset_bg</item>
        <item name="tvBgTop">@color/sunset_top</item>
        <item name="tvBgBottom">@color/sunset_bottom</item>
        <item name="tvSurface">@color/sunset_surface</item>
        <item name="tvSurfaceHigh">@color/sunset_surface_high</item>
        <item name="tvSurfaceStroke">@color/sunset_stroke</item>
        <item name="tvAccent">@color/sunset_accent</item>
        <item name="tvAccentSecondary">@color/sunset_accent2</item>
        <item name="tvTextPrimary">@color/sunset_text_primary</item>
        <item name="tvTextSecondary">@color/sunset_text_secondary</item>
        <item name="tvTextHint">@color/sunset_text_hint</item>
        <item name="tvLive">@color/sunset_live</item>
        <item name="tvLiveBg">@color/sunset_live_bg</item>
        <item name="tvSelected">@color/sunset_selected</item>
        <item name="tvSelectedBg">@color/sunset_selected_bg</item>
        <item name="tvWarning">@color/sunset_warning</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="Theme.TVApp.Sunset.Black" parent="Theme.TVApp.Sunset">
        <item name="android:windowBackground">@color/black</item>
        <item name="tvTextPrimary">@color/midnight_text_primary</item>
        <item name="tvTextSecondary">@color/midnight_text_secondary</item>
    </style>

    <!-- Світлая: светлые поверхности, тонкий шрифт; сцена плеера всё равно чёрная -->
    <style name="Theme.TVApp.Light" parent="Theme.TVApp.Base">
        <item name="tvBackground">@color/light_bg</item>
        <item name="tvBgTop">@color/light_top</item>
        <item name="tvBgBottom">@color/light_bottom</item>
        <item name="tvSurface">@color/light_surface</item>
        <item name="tvSurfaceHigh">@color/light_surface_high</item>
        <item name="tvSurfaceStroke">@color/light_stroke</item>
        <item name="tvAccent">@color/light_accent</item>
        <item name="tvAccentSecondary">@color/light_accent2</item>
        <item name="tvTextPrimary">@color/light_text_primary</item>
        <item name="tvTextSecondary">@color/light_text_secondary</item>
        <item name="tvTextHint">@color/light_text_hint</item>
        <item name="tvLive">@color/light_live</item>
        <item name="tvLiveBg">@color/light_live_bg</item>
        <item name="tvSelected">@color/light_selected</item>
        <item name="tvSelectedBg">@color/light_selected_bg</item>
        <item name="tvWarning">@color/light_warning</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <!-- В светлой теме и всплывающие диалоги светлые, а не дефолтные тёмные -->
        <item name="alertDialogTheme">@style/ThemeOverlay.TVApp.Light.Dialog.Alert</item>
    </style>

    <style name="ThemeOverlay.TVApp.Light.Dialog.Alert" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/light_accent</item>
        <item name="android:colorBackground">@color/light_surface</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <style name="Theme.TVApp.Light.Black" parent="Theme.TVApp.Light">
        <item name="android:windowBackground">@color/black</item>
        <item name="tvTextPrimary">@color/midnight_text_primary</item>
        <item name="tvTextSecondary">@color/midnight_text_secondary</item>
    </style>
</resources>
