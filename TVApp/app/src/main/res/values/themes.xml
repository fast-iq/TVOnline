<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TVApp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/background_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- TV оптимизации -->
        <item name="android:defaultFocusHighlightEnabled">true</item>
    </style>

    <style name="Theme.TVApp.Black" parent="Theme.TVApp">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
